{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://we-make-specs.dev/sdlc/07-review.state.schema.json",
  "title": "SDLC evidence-checked review state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "packageId",
    "baseline",
    "contextLoaded",
    "acceptanceCriteria",
    "findings",
    "trialFixes",
    "multipleTrialFixReason",
    "selectedTrialFixId",
    "finalFullCheck",
    "verdict",
    "finalCommit"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "packageId": { "type": "string", "minLength": 1 },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseCommit", "implementationCommit", "implementationFullCheck"],
      "properties": {
        "baseCommit": { "type": "string", "minLength": 7 },
        "implementationCommit": { "type": "string", "minLength": 7 },
        "implementationFullCheck": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/fullCheck" }
          ]
        }
      }
    },
    "contextLoaded": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "acceptanceCriteria": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/acAssessment" }
    },
    "findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding" }
    },
    "trialFixes": {
      "type": "array",
      "items": { "$ref": "#/$defs/trialFix" }
    },
    "multipleTrialFixReason": { "type": ["string", "null"] },
    "selectedTrialFixId": { "type": ["string", "null"] },
    "finalFullCheck": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/fullCheck" }
      ]
    },
    "verdict": {
      "enum": ["IN_REVIEW", "APPROVE", "REQUEST_CHANGES", "COMMENT", "ASK_HUMAN"]
    },
    "finalCommit": { "type": ["string", "null"], "minLength": 7 }
  },
  "$defs": {
    "acAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "status", "evidence"],
      "properties": {
        "id": { "type": "string", "pattern": "^AC-[0-9]+$" },
        "text": { "type": "string", "minLength": 1 },
        "status": { "enum": ["MET", "NOT_MET", "PARTIAL", "NOT_VERIFIABLE"] },
        "evidence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reference", "statement"],
      "properties": {
        "kind": {
          "enum": [
            "USER",
            "TICKET",
            "ACCEPTANCE_CRITERION",
            "REGISTRY",
            "REFERENCE_IMPLEMENTATION",
            "APPROVED_DESIGN",
            "REVIEWER_INFERENCE",
            "TEST_OR_RUNTIME_EVIDENCE"
          ]
        },
        "reference": { "type": "string", "minLength": 1 },
        "statement": { "type": "string", "minLength": 1 }
      }
    },
    "evidenceCheck": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": [
        "result",
        "path",
        "reason",
        "baselineTradeoff",
        "correctionTradeoff",
        "decisionId",
        "trialFixId"
      ],
      "properties": {
        "result": { "enum": ["VALID", "NOT_A_PROBLEM", "PARTLY_RIGHT", "ASK_HUMAN"] },
        "path": { "enum": ["NO_CHANGE", "LIGHT", "FULL", "HUMAN"] },
        "reason": { "type": "string", "minLength": 1 },
        "baselineTradeoff": { "type": "string", "minLength": 1 },
        "correctionTradeoff": { "type": ["string", "null"] },
        "decisionId": { "type": ["string", "null"] },
        "trialFixId": { "type": ["string", "null"] }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "problem",
        "evidence",
        "objective",
        "supportingSources",
        "conflictingSources",
        "severity",
        "confidence",
        "impactAreas",
        "failureScenario",
        "verificationMethod",
        "suggestedFix",
        "evidenceCheck"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^RF-[0-9]+$" },
        "status": { "enum": ["OPEN", "CHECKED", "CLOSED"] },
        "problem": { "type": "string", "minLength": 1 },
        "evidence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "objective": { "$ref": "#/$defs/source" },
        "supportingSources": { "type": "array", "items": { "$ref": "#/$defs/source" } },
        "conflictingSources": { "type": "array", "items": { "$ref": "#/$defs/source" } },
        "severity": { "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"] },
        "confidence": { "enum": ["LOW", "MEDIUM", "HIGH"] },
        "impactAreas": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "LOCAL_IMPLEMENTATION",
              "TESTS",
              "BUSINESS_BEHAVIOR",
              "SECURITY",
              "PUBLIC_CONTRACT",
              "ARCHITECTURE",
              "DATA",
              "OPERATIONS"
            ]
          }
        },
        "failureScenario": { "type": "string", "minLength": 1 },
        "verificationMethod": { "type": "string", "minLength": 1 },
        "suggestedFix": { "type": ["string", "null"] },
        "evidenceCheck": { "$ref": "#/$defs/evidenceCheck" }
      }
    },
    "trialFix": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "findingIds",
        "path",
        "baseCommit",
        "commit",
        "workspaceMode",
        "separateReason",
        "status",
        "comparison",
        "defectRemovedEvidence",
        "invariantChecks",
        "targetedChecks"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^TF-[0-9]+$" },
        "findingIds": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "path": { "enum": ["LIGHT", "FULL"] },
        "baseCommit": { "type": "string", "minLength": 7 },
        "commit": { "type": ["string", "null"], "minLength": 7 },
        "workspaceMode": { "enum": ["SHARED_TRIAL_BRANCH", "ISOLATED_WORKTREE"] },
        "separateReason": { "type": ["string", "null"] },
        "status": { "enum": ["PLANNED", "BUILT", "CHECKED"] },
        "comparison": { "enum": [null, "SAFE_IMPROVEMENT", "KEEP_ORIGINAL"] },
        "defectRemovedEvidence": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "invariantChecks": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "targetedChecks": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "fullCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "command", "result", "completedAt", "source", "evidence"],
      "properties": {
        "commit": { "type": "string", "minLength": 7 },
        "command": { "type": "string", "minLength": 1 },
        "result": { "enum": ["PASSED", "FAILED"] },
        "completedAt": { "type": "string", "minLength": 1 },
        "source": { "enum": ["STEP_06", "REVIEW"] },
        "evidence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
